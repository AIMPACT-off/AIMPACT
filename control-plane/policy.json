{
  "version": "1.0.0",
  "company": "AIMPACT",
  "principal": {
    "name": "Kim Hyung Nam",
    "role": "sole_human_business_authority",
    "final_decision_maker": true
  },
  "decision_classes": {
    "D0": ["health_check", "retry", "cache_refresh", "reindex", "logging", "alerting", "non_destructive_validation"],
    "D1": ["approved_workflow_execution", "routine_normalization", "scheduled_distribution", "approved_reverification", "reversible_containment"],
    "D2": ["material_production_change", "canonical_business_data_change", "customer_impacting_change", "pricing_change", "external_commitment", "destructive_operation", "security_policy_change", "financial_action"],
    "D3": ["ownership", "governance", "legal_commitment", "billing_plan", "capital_allocation", "strategic_direction", "new_revenue_model", "partnership_commitment", "authority_transfer"]
  },
  "states": ["FACT", "HYPOTHESIS", "VERIFIED", "BLOCKED", "APPROVAL_REQUIRED", "FAILED", "RECOVERING", "LIVE"],
  "control_loop": ["INTENT", "POLICY_CHECK", "PRECONDITION_CHECK", "EXECUTE", "OBSERVE", "VALIDATE", "LOG", "UPDATE_STATE", "ALERT", "CONTAIN_OR_ROLLBACK", "APPROVAL_IF_REQUIRED"],
  "error_loop": ["DETECT", "CLASSIFY", "CORRELATE", "ROOT_CAUSE", "CONTAIN", "FIX", "REGRESSION_TEST", "DEPLOY", "VERIFY", "CLOSE", "KNOWLEDGE"],
  "commercial_truth_rules": {
    "customer_requires_record": true,
    "revenue_requires_transaction": true,
    "outcome_requires_measurement": true,
    "case_study_requires_documented_outcome": true,
    "verified_tool_requires_current_evidence": true
  },
  "source_of_truth": {
    "code": "github",
    "production_database": "supabase",
    "operations_review": "airtable",
    "runtime": "netlify",
    "distribution": "metricool"
  },
  "certification": {
    "required": [
      "central_state_consistent",
      "production_reachable",
      "core_customer_flow_verified",
      "data_lineage_verified",
      "automation_failure_observable",
      "incident_remediation_connected",
      "security_controls_verified",
      "kpi_data_derived",
      "authorization_enforced",
      "recovery_regression_verified"
    ],
    "default_state": "NOT_CERTIFIED"
  }
}
